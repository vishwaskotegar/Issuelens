# IssueLens Environment Configuration
# Placeholders only — never commit real credentials or secrets to version control.

APP_ENV=local
LOG_LEVEL=INFO

# Service Limits and Timeouts
REQUEST_TIMEOUT_SECONDS=15
MAX_REPOSITORY_BYTES=50000000
MAX_FILES_SCANNED=10000
MAX_FILE_BYTES=500000
MAX_TOOL_CALLS=12
MAX_RETRIEVAL_ROUNDS=3
MAX_REPORT_TOKENS=2500
SNAPSHOT_CACHE_DIR=.cache/issuelens/snapshots
MAX_CACHED_SNAPSHOTS=10
MAX_CACHE_TOTAL_BYTES=500000000

# Optional / Future Phase Integrations
# Database (Phase 6)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/issuelens

# LLM Provider (Phase 3)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# GitHub Client (Phase 1)
GITHUB_TOKEN=
